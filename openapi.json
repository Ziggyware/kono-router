                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "ROUTER_API_KEY"
      },
      "adminSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-admin-secret",
        "description": "ADMIN_SECRET"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Candidate": {
        "type": "object",
        "properties": {
          "tupleId": {
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          },
          "iqEffective": {
            "type": "number"
          },
          "supportsReasoning": {
            "type": "boolean"
          },
          "supportsVision": {
            "type": "boolean"
          },
          "isCodingSpecialist": {
            "type": "boolean"
          },
          "contextWindow": {
            "type": "integer"
          },
          "reliabilityDraw": {
            "type": "number",
            "description": "Thompson sample from discounted Beta posterior"
          },
          "ewmaTtftMs": {
            "type": "number"
          },
          "ewmaTps": {
            "type": "number"
          },
          "logTtftMu": {
            "type": "number",
            "description": "Kalman-filtered mean of ln(TTFT ms)"
          },
          "logTtftSigma": {
            "type": "number",
            "description": "Std-dev of ln(TTFT ms)"
          },
          "expectedFastMs": {
            "type": "number"
          },
          "smartScore": {
            "type": "number"
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          },
          "control_kernel": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "ttft_model": {
                "type": "string"
              },
              "reliability": {
                "type": "string"
              },
              "exploration": {
                "type": "string"
              },
              "hedging": {
                "type": "string"
              },
              "dispatch_tiers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "request_guarantee": {
                "type": "string"
              },
              "strict_errors": {
                "type": "boolean"
              }
            }
          },
          "security": {
            "type": "object",
            "properties": {
              "auth_enabled": {
                "type": "boolean"
              },
              "admin_guard_enabled": {
                "type": "boolean"
              },
              "openrouter_free_enabled": {
                "type": "boolean"
              },
              "l1_cache_entries": {
                "type": "integer"
              },
              "service_json_load_error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "current_best_fast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "current_best_smart": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "current_best_code": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "current_best_reasoning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          }
        }
      },
      "Coverage": {
        "type": "object",
        "properties": {
          "configured_endpoints": {
            "type": "integer"
          },
          "registry_endpoints": {
            "type": "integer"
          },
          "catalog_tuples": {
            "type": "integer"
          },
          "sweep_candidates": {
            "type": "integer"
          }
        }
      },
      "EndpointList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Coverage"
          },
          {
            "type": "object",
            "properties": {
              "object": {
                "const": "list"
              },
              "policy": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "catalog_tuples": {
                      "type": "integer"
                    },
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "object": {
            "const": "list"
          },
          "accepts_any_model": {
            "const": true
          },
          "model_policy": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "object",
                "owned_by"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "object": {
                  "const": "model"
                },
                "created": {
                  "type": "integer"
                },
                "owned_by": {
                  "type": "string"
                },
                "tuple_id": {
                  "type": "string"
                },
                "iq_effective": {
                  "type": "number"
                },
                "supports_reasoning": {
                  "type": "boolean"
                },
                "supports_vision": {
                  "type": "boolean"
                },
                "is_coding_specialist": {
                  "type": "boolean"
                },
                "context_window": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "description": "Malformed bodies are normalised, never rejected. Any model id is accepted: free:* aliases select a mode, unknown ids route by trigram/Jaccard similarity.",
        "properties": {
          "model": {
            "type": "string",
            "default": "free:auto",
            "examples": [
              "free:auto",
              "free:fast",
              "free:smart",
              "free:code",
              "free:reasoning"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "developer",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tool_calls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ToolCall"
                  }
                },
                "tool_call_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "prompt": {
            "type": "string",
            "description": "Used when messages is absent"
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "max_tokens": {
            "type": "integer"
          },
          "max_completion_tokens": {
            "type": "integer"
          },
          "reasoning_effort": {
            "type": "string"
          },
          "reasoning": {
            "type": "object",
            "description": "Forwarded verbatim (OpenRouter-style reasoning config)"
          },
          "response_format": {
            "type": "object"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tool_choice": {},
          "parallel_tool_calls": {
            "type": "boolean"
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "const": "function"
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "string",
                "description": "JSON text; object arguments from upstreams are serialised"
              }
            }
          }
        }
      },
      "SpanRec": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "examples": [
              "chat.completions",
              "rank",
              "tier",
              "attempt"
            ]
          },
          "start": {
            "type": "number",
            "description": "epoch ms"
          },
          "end": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "unset",
              "ok",
              "error"
            ]
          },
          "attrs": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "attrs": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "Trace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "spans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpanRec"
            }
          }
        }
      },
      "TraceSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "$ref": "#/components/schemas/SpanRec"
          },
          "spans": {
            "type": "integer"
          },
          "errors": {
            "type": "integer"
          }
        }
      },
      "TraceEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "start",
              "end",
              "event"
            ]
          },
          "trace": {
            "type": "string"
          },
          "span": {
            "$ref": "#/components/schemas/SpanRec"
          }
        }
      },
      "NokeyMeta": {
        "type": "object",
        "properties": {
          "degraded": {
            "type": "boolean"
          },
          "requested_model": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "tuple_id": {
            "type": "string"
          },
          "endpoints_available": {
            "type": "integer"
          },
          "endpoints_attempted": {
            "type": "integer"
          },
          "attempts": {
            "type": "integer"
          },
          "routing_kernel": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "ChatCompletion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "nokey": {
            "$ref": "#/components/schemas/NokeyMeta"
          },
          "telemetry": {
            "type": "object",
            "properties": {
              "mode_selected": {
                "type": "string",
                "enum": [
                  "fast",
                  "smart",
                  "code",
                  "reasoning"
                ]
              },
              "iq_effective": {
                "type": "number"
              },
              "supports_reasoning": {
                "type": "boolean"
              },
              "is_coding_specialist": {
                "type": "boolean"
              },
              "reliability_draw": {
                "type": "number"
              },
              "observed_ttft_ms": {
                "type": "number"
              },
              "observed_total_ms": {
                "type": "number"
              },
