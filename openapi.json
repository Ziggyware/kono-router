                }
              }
            }
          },
          "429": {
            "description": "Per-isolate rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": [
          "inference"
        ],
        "operationId": "chatCompletions",
        "summary": "Chat completion (JSON or SSE)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "example": {
                "model": "free:auto",
                "messages": [
                  {
                    "role": "user",
                    "content": "ping"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion. With stream=true, headers and a `: trace <id>` comment are sent immediately, `: routing` heartbeats follow every 5 s until an upstream commits, then chunks stream in real time: `delta.reasoning_content` (including leading inline <think> blocks), `delta.content`, `delta.tool_calls` (stable index; id and type on each call's first chunk). The final chunk carries `nokey`.",
            "headers": {
              "traceparent": {
                "description": "W3C trace context of this request's root span",
                "schema": {
                  "type": "string"
                }
              },
              "Server-Timing": {
                "description": "ttft and total milliseconds (buffered responses)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Nokey-Attempts": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Nokey-Endpoints": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Nokey-Degraded": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletion"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "`data: <chat.completion.chunk>` frames, terminated by `data: [DONE]`"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid ROUTER_API_KEY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Per-isolate rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/images/generations": {
