            "type": "integer"
          },
          "promoted": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tupleId": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "passed": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                }
