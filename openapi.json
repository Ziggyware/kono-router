{
  "openapi": "3.1.0",
  "info": {
    "title": "nokey-router",
    "version": "asck-v1",
    "description": "OpenAI-compatible free-inference router. Chat and image routes never fail: after an exhaustive endpoint sweep they return 200 with `nokey.degraded=true` (buffered responses also set `X-Nokey-Degraded: 1`; streams send headers before routing settles, so they signal it in-band). Every request is traced: `traceparent` is honoured inbound and returned outbound, spans are exported via OpenTelemetry and kept in a per-isolate ring under `/v1/traces`."
  },
  "servers": [
    {
      "url": "https://nokey-router.ziggyware.deno.net"
    }
  ],
  "tags": [
    {
      "name": "inference"
    },
    {
      "name": "catalog"
    },
    {
      "name": "admin"
    },
    {
      "name": "system"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "summary": "Kernel state, coverage, top-5 per mode",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
