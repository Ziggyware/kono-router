          }
        }
      },
      "ImageRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "enum": [
              "nokey-image",
              "nokey-image-flux",
              "nokey-image-horde"
            ],
            "default": "nokey-image"
          },
          "size": {
            "type": "string",
            "enum": [
              "512x512",
              "1024x1024",
              "1024x576",
              "576x1024",
              "1792x1024",
              "1024x1792"
            ],
            "default": "1024x1024"
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "response_format": {
            "type": "string",
            "enum": [
              "url",
              "b64_json"
            ],
            "default": "url"
          }
        }
      },
      "ImageResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "b64_json": {
                  "type": "string"
                }
              }
            }
          },
          "nokey": {
            "type": "object",
            "properties": {
