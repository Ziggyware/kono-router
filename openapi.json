    "/v1/source": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "source",
        "summary": "Read an allowlisted deployment file",
        "security": [
          {
            "bearerAuth": [],
            "adminSecret": []
          }
        ],
        "parameters": [
          {
            "name": "file",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "main.ts",
                "math.ts",
                "trace.ts",
                "index.html",
                "openapi.json",
                "CHANGES.md",
                "services.json",
                "deno.json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "lines": {
                      "type": "integer"
                    },
                    "content": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "File not in allowlist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
