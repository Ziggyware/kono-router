{
  "entrypoint": "main.ts",
  "tasks": {
    "start": "deno run --unstable-kv --unstable-cron -A main.ts",
    "dev": "deno run --watch --unstable-kv --unstable-cron -A main.ts",
    "build": "echo 'Skipping Fresh build - standalone Hono entrypoint'",
    "check": "deno check main.ts math.ts trace.ts tools.ts toolbox/ compiler/ tests/",
    "test": "deno test --unstable-kv -A tests/"
  },
  "unstable": [
    "kv",
    "cron"
  ],
  "imports": {
    "hono": "npm:hono@4.13.17",
    "hono/cors": "npm:hono@4.13.17/cors",
    "hono/body-limit": "npm:hono@4.13.17/body-limit",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.10.0",
    "sucrase": "npm:sucrase@3.35.0",
    "@libsql/client/http": "npm:@libsql/client@0.18.0/http",
    "typescript": "npm:typescript@5.9.3"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  }
}
