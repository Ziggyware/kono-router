{
  "entrypoint": "main.ts",
  "tasks": {
    "start": "deno serve --unstable-kv --unstable-cron -A main.ts",
    "dev": "deno run --watch --unstable-kv --unstable-cron -A main.ts",
    "build": "echo 'Skipping Fresh build - standalone Hono entrypoint'",
    "check": "deno check main.ts math.ts trace.ts tools.ts toolbox/ tests/",
    "test": "deno test --unstable-kv -A tests/"
  },
  "unstable": [
    "kv",
    "cron"
  ],
  "imports": {
    "hono": "npm:hono@4.13.16",
    "hono/cors": "npm:hono@4.13.16/cors",
    "hono/body-limit": "npm:hono@4.13.16/body-limit",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.10.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  }
}
